<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Agenda_Web Public</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Agenda_Web.styles.css" asp-append-version="true" />
</head>
@* <body style="background: linear-gradient(to right, #0062E6, #33AEFF);"> *@
<body style="background: linear-gradient(to right, #8e2de2, #ff6a88);">
    @* <body style="background: linear-gradient(to right, #11998e, #38ef7d);"> *@
