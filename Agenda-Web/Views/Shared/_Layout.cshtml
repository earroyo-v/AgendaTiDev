@using System.Security.Claims
@inject Agenda_BSS.Interfaces.IUsuario usuario

@{
    var userId = User.FindFirst("IdUsuario")?.Value;
    var result = usuario.GetUser(int.Parse(userId));
    var us = result.Result.Data;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Agenda_Web Main</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Agenda_Web.styles.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
</head>
<body>
    <header>
        @* <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Agenda_Web</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav> *@
        <nav class="navbar navbar-dark bg-dark fixed-top">
            <div class="container-fluid">
                <a class="navbar-brand" href="#">
                    @*<img src="/docs/5.3/assets/brand/bootstrap-logo.svg" alt="Logo" width="30" height="24" class="d-inline-block align-text-top">*@
                    @if (us.Foto?.Any() == true)
                    {
                        <img src="~/img/@us.Foto" width="25" height="25" class="rounded-circle">
                    }
                    else
                    {
                        <img src="~/img/wertyujkedfmncvhgchdjskasdmvnhcjdsmnfhjdks,dmsfjrsjenmlas.jpg" width="25" height="25" class="rounded-circle">
                    }

                    @us.NickName
                </a>
                <img src="~/img/C-image-for-Netgen-1024x1024.png" width="46" height="46" class="position-fixed start-50 translate-middle-x mt-0">
                @*<form class="search-bar position-fixed + start-50 + translate-middle-x" style="max-width: 400px;" method="get" action="/Home/Buscar">
                    <input class="form-control ps-5 rounded-pill border-0 shadow-sm"
                           type="search"
                           placeholder="Buscar..."
                           aria-label="Buscar"
                           name="data">
                    <span class="position-absolute top-50 start-0 translate-middle-y ps-3 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                </form>*@
                <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasDarkNavbar" aria-controls="offcanvasDarkNavbar" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="offcanvas offcanvas-end bg-dark text-white" tabindex="-1" id="offcanvasDarkNavbar" aria-labelledby="offcanvasDarkNavbarLabel">
                    <div class="offcanvas-header">
                        @if (us.Foto?.Any() == true)
                        {
                            <img src="~/img/@us.Foto" width="80" height="80" class="rounded-circle">
                        }
                        else
                        {
                            <img src="~/img/wertyujkedfmncvhgchdjskasdmvnhcjdsmnfhjdks,dmsfjrsjenmlas.jpg" width="55" height="55" class="rounded-circle">
                        }
                        <h5 class="offcanvas-title" id="offcanvasDarkNavbarLabel">@us.Nombre @us.ApellidoPaterno @us.ApellidoMaterno</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                    </div>
                    <div class="offcanvas-body d-flex flex-column h-100">
                        <ul class="navbar-nav pe-3">
                            <li class="nav-item">
                                <a class="nav-link active" href="/Agenda/Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/User/Index/@us.IdUsuario">Mi Perfil</a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Opciones
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark">
                                    <li><a class="dropdown-item" href="/User/EditarView/@us.IdUsuario">Editar informacion</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="/User/CambiarPsswView/">Cambiar Contraseña</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="/User/EliminarView">Eliminar Cuenta</a></li>
                                </ul>
                            </li>
                        </ul>

                        <!-- 🔻 Botón pegado al fondo -->
                        <div class="mt-auto text-end pe-3 pt-3 border-top">
                            <a class="btn btn-outline-light w-100" href="/Home/LogOut">Log Out</a>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <br />
        <br />
        <br />
        @if (TempData["success"] != null)
        {
            <div class="alert alert-success small">@TempData["success"]</div>
        }
        @if (TempData["error"] != null)
        {
            <div class="alert alert-danger small">@TempData["error"]</div>
        }
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Agenda_Web - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>