@model Agenda_Web.Models.RegisterViewModel

@{
    Layout = "~/Views/Shared/_LayoutPublic.cshtml";
    ViewData["Title"] = "Index";
}

<section class="vh-100 gradient-custom">
    <div class="container py-5 h-100">
        <div class="row d-flex justify-content-center align-items-center h-100">
            <div class="col-12 col-md-8 col-lg-6 col-xl-5">
                <div class="card bg-dark text-white" style="border-radius: 1rem;">
                    <div class="card-body p-5 text-center">

                        <div class="mb-md-5 mt-md-4 pb-5">

                            <h2 class="fw-bold mb-2 text-uppercase">Register User</h2>
                            <p class="text-white-50 mb-5">Please enter your information!</p>

                            <form asp-action="Register" asp-controller="User" method="post" enctype="multipart/form-data">
                                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                <div data-mdb-input-init class="form-outline form-white mb-4">
                                    <label asp-for="Nombre" class="form-label"></label>
                                    <input asp-for="Nombre" class="form-control form-control-lg" />
                                    <span asp-validation-for="Nombre" class="text-danger"></span>
                                </div>
                                <div data-mdb-input-init class="form-outline form-white mb-4">
                                    <label asp-for="ApellidoPaterno" class="form-label"></label>
                                    <input asp-for="ApellidoPaterno" class="form-control form-control-lg" />
                                    <span asp-validation-for="ApellidoPaterno" class="text-danger"></span>
                                </div>
                                <div data-mdb-input-init class="form-outline form-white mb-4">
                                    <label asp-for="ApellidoMaterno" class="form-label"></label>
                                    <input asp-for="ApellidoMaterno" class="form-control form-control-lg" />
                                    <span asp-validation-for="ApellidoMaterno" class="text-danger"></span>
                                </div>
                                <div data-mdb-input-init class="form-outline form-white mb-4">
                                    <label asp-for="NickName" class="form-label"></label>
                                    <input asp-for="NickName" class="form-control form-control-lg" />
                                    <span asp-validation-for="NickName" class="text-danger"></span>
                                </div>
                                <div data-mdb-input-init class="form-outline form-white mb-4">
                                    <label asp-for="Email" class="form-label"></label>
                                    <input asp-for="Email" class="form-control form-control-lg" />
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>
                                <div data-mdb-input-init class="form-outline form-white mb-4">
                                    <label asp-for="Password" class="form-label"></label>
                                    <input asp-for="Password" class="form-control form-control-lg" type="password" />
                                    <span asp-validation-for="Password" class="text-danger"></span>
                                </div>
                                <div data-mdb-input-init class="form-outline form-white mb-4">
                                    <label asp-for="PasswordCheck" class="form-label"></label>
                                    <input asp-for="PasswordCheck" class="form-control form-control-lg" type="password" />
                                    <span asp-validation-for="PasswordCheck" class="text-danger"></span>
                                </div>
                                <div data-mdb-input-init class="form-outline form-white mb-4">
                                    <label asp-for="FechaNacimiento" class="form-label"></label>
                                    <input asp-for="FechaNacimiento" type="date" class="form-control form-control-lg" />
                                    <span asp-validation-for="FechaNacimiento" class="text-danger"></span>
                                </div>
                                <div data-mdb-input-init class="form-outline form-white mb-4">
                                    <label asp-for="ArchivoImagen" class="form-label"></label>
                                    <input asp-for="ArchivoImagen" class="form-control form-control-lg" type="file" />
                                    <span asp-validation-for="ArchivoImagen" class="text-danger"></span>
                                </div>
                                <div data-mdb-input-init class="form-outline form-white mb-4">
                                    <label asp-for="UrlPerfil" class="form-label"></label>
                                    <input asp-for="UrlPerfil" class="form-control form-control-lg" type="text" />
                                    <span asp-validation-for="UrlPerfil" class="text-danger"></span>
                                </div>
                                <button data-mdb-button-init data-mdb-ripple-init class="btn btn-outline-light btn-lg px-5" type="submit">Register</button>
                            </form>
                        </div>

                        <div>
                            <p class="mb-0">
                                <a href="/Login" class="text-white-50 fw-bold">Back</a>
                            </p>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
