@inject Agenda_BSS.Interfaces.IRedSocial redSocial

@{
    var result = redSocial.GetRedSociales();
    var listRedSoacial = result.Result.Data;
}

<div class="d-flex justify-content-between">
    <h2>Mi Agenda</h2>
    <div>
        @* @if (user.BirthDay != 0)
        {
            <b class="btn me-2" style="color:darkblue"><strong>Feliz Cumpleaños @user.Nombre</strong></b>
        } *@
    </div>
    <div>
        <form class="search-bar position-relative mx-auto" style="max-width: 400px;" method="post"
              action="/Agenda/Buscar">
            <input class="form-control ps-5 rounded-pill border-0 shadow-sm" type="search" placeholder="Buscar..."
                   aria-label="Buscar" name="data" @*style="border: 2px solid #ff69b4; background-color: #fff0f5;">
                   style="border: 2px solid #ff69b4; background-color: #FFFDB9;">*@
                   style="border: 2px solid #ff69b4; background-color: #D4D4D4; ">
            <span class="position-absolute top-50 start-0 translate-middle-y ps-3 text-muted">
                <i class="bi bi-search"></i>
            </span>
        </form>
    </div>
</div>


<p>
    <div class="d-flex justify-items-center">
        @if (TempData["t"] != null)
        {
            <p>Tienes <strong>@TempData["t"]</strong> contacto(s) almacenado(s)</p>
        }
        @if (TempData["te"] != null)
        {
            <p><strong>@TempData["te"]</strong> contacto(s) relacionado(s)</p>
        }
        <div class="ms-auto d-flex">
            <button id="addContact" class="btn btn-success btn-group-sm">Agregar</button>
        </div>
    </div>
</p>

<div id="container"></div>

@await Html.PartialAsync("_modalContacto")

@section Scripts {
    <script>
        class Contacto {
            constructor() {
                this.initVars();
                this.init();
            }

            initVars(){
                this.modal = new bootstrap.Modal(document.getElementById("miModalAdd"));

                this.redSocial = document.getElementById("netContainer");
                this.redSocialList = @Html.Raw(Json.Serialize(listRedSoacial));

                this.contactoslist = [];
                this.modalTitle = document.querySelector(".modal-title");
                this.inputIdContact = document.getElementById("IdContacto");
                this.inputNombre = document.getElementById("Nombre");
                this.inputApPaterno = document.getElementById("ApellidoPaterno");
                this.inputApMaterno = document.getElementById("ApellidoMaterno");
                this.inputBirthD = document.getElementById("FechaNacimiento");
                this.inputFoto = document.getElementById("Foto");
                this.inputTelefono = document.getElementById("Telefono");
                this.inputEmail = document.getElementById("Email");
            }

            init() {
                this.GetContactos();
                document.getElementById("addContact").addEventListener("click", () => {
                    this.ResetInputsModal();
                    this.modalTitle.textContent = "Agregar Contacto";
                    this.modal.show();
                });
                document.getElementById("netButton").addEventListener("click", () => {
                    this.CreateRedSocial();
                });
                document.getElementById("formContacto").addEventListener("click", (e) => {
                    const deleteBtn = e.target.closest(".netButtonDelete");
                    if(deleteBtn){
                        e.target.closest(".net").remove();
                        let rows = document.querySelectorAll(".net");
                        rows.forEach((row, index) => {
                            let select = row.querySelector(".netSelect");
                            let input = row.querySelector(".netInput");
                            if (select) {
                                select.name = `ContactoRedSocials[${index}].IdRedSocial`;
                            }
                            if (input) {
                                input.name = `ContactoRedSocials[${index}].UrlPerfil`;
                            }
                        });
                    }
                });
                document.getElementById("formContacto").addEventListener("submit", async (e) => {
                    if (!$("#formContacto").valid()) {
                        return;
                    }
                    e.preventDefault();
                    if(!this.inputIdContact.value){
                        this.CreateContactos("/Home/CreateContactos/",e.target);
                    }
                    else{
                        console.log("editar");
                        @*this.CreateContactos("/Home/EditContactos/",e.target);*@
                    }                    
                });
                document.getElementById("container").addEventListener("click", (e) => {
                    const btn = e.target.closest(".editContact");
                    if (btn) {
                        let id = btn.dataset.id;
                        const contacto = this.contactoslist.find(item => item.idContacto === Number(id));
                        console.log(contacto)
                        this.ResetInputsModal();
                        this.modalTitle.textContent = "Editar Contacto";
                        this.inputIdContact.value = contacto.idContacto;
                        this.inputNombre.value = contacto.nombre;
                        this.inputApPaterno.value = contacto.apellidoPaterno;
                        this.inputApMaterno.value = contacto.apellidoPaterno;
                        this.inputBirthD.value = contacto.fechaNacimiento;
                        this.inputTelefono.value = contacto.telefono;
                        this.inputEmail.value = contacto.email;
                        this.inputFoto.value = contacto.foto;
                        (contacto.contactoRedSocials || []).forEach((red,index) => {
                            this.CreateRedSocial();
                            // html += `<p><strong>${red.nombreRedSocial}:</strong> ${red.urlPerfil}</p>`;
                        });
                        this.modal.show();
                    }
                });
            }

            async CreateContactos(url,Data) {
                try {
                    // const formData = new FormData(document.getElementById("formContacto"));
                    const formData = new FormData(Data);
                    const response = await fetch(url, {
                        method: "POST",
                        body: formData
                    });

                    if (!response.ok) {
                        throw new Error("Error en la respuesta del servidor");
                    }

                    const data = await response.json();

                    if (!data.error) {
                        this.modal.hide();
                        this.GetContactos();
                    } else {
                        console.error("Error del backend:", data.mensaje);
                    }
                }
                catch (error) {
                    console.error("Error general:", error);
                }
            }

            async GetContactos() {
                try {
                    const response = await fetch("/Home/GetContactos/");

                    if (!response.ok) {
                        throw new Error("Error en la respuesta del servidor");
                    }

                    const data = await response.json();

                    if (!data.error) {
                        this.contactoslist = [...data.data];
                        this.CreateTable(data);
                    } else {
                        console.error("Error del backend:", data.mensaje);
                    }
                }
                catch (error) {
                    console.error("Error general:", error);
                }
            }

            CreateTable(data) {
                const contenedor = document.getElementById("container");
                let html = "";
                data.data.forEach(item => {
                    let accordionId = "accordion" + item.idContacto;
                    let foto = item.foto || "wertyujkedfmncvhgchdjskasdmvnhcjdsmnfhjdks,dmsfjrsjenmlas.jpg";
                    let redes = this.CreatePerfil(item);
                    let bt = this.CreateBirthDay(item);
                    html += `<div class="card mb-2 bg-white p-3">
                    <div class="row g-0">
                        <!-- Foto del contacto -->
                        <div class="col-md-4 d-flex align-items-center justify-content-center">
                                <img src="/img/${foto}" class="rounded-circle" width="145" height="145" />
                        </div>

                        <!-- Acordeón con detalles -->
                        <div class="col-md-8">
                            <div class="card-body">
                                <div class="d-flex justify-items-center">
                                ${bt}
                                    <div class="ms-auto d-flex">
                                        <button type="button" class="btn editContact" title="Editar" data-id="${item.idContacto}">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                        <button type="button" class="btn deleteContct" title="Eliminar" data-id="${item.idContacto}">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </div>

                                <div class="accordion" id="${accordionId}">
                                    <div class="accordion-item">
                                        <h2 class="accordion-header" id="heading-${item.idContacto}">
                                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-${item.idContacto}" aria-expanded="false" aria-controls="collapse-${item.idContacto}">
                                                <h5 class="card-title mb-0">${item.nombre} ${item.apellidoPaterno} ${item.apellidoMaterno}</h5>
                                            </button>
                                        </h2>
                                        <div id="collapse-${item.idContacto}" class="accordion-collapse collapse" aria-labelledby="heading-${item.idContacto}" data-bs-parent="#${accordionId}">
                                            <div class="accordion-body">
                                                <p><strong>Edad:</strong> ${item.edad}</p>
                                                <p><strong>Teléfono:</strong> ${item.telefono}</p>
                                                <p><strong>Email:</strong> ${item.email}</p>
                                                ${redes}
                                                <!-- Agrega más campos si necesitas -->
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>`;
                });
                contenedor.innerHTML = html;
            }
            CreatePerfil(item){
                let html = "";
                (item.contactoRedSocials || []).forEach(red => {
                    html += `<p><strong>${red.nombreRedSocial}:</strong> ${red.urlPerfil}</p>`;
                });
                return html;
            }
            CreateBirthDay(item){
                if(item.birthDay){
                    return `<b class="btn me-2" style="color:darkblue"><strong>Feliz Cumpleaños ${item.nombre}</strong></b>`;
                }
                return "";
            }
            CreateRedSocial(){
                let option = '';
                (this.redSocialList).forEach(item=>{
                    option += `<option value="${item.idRedSocial}">${item.nombreRedSocial}</option>`
                });

                let rows = document.querySelectorAll(".net");
                let index = rows.length;

                let newRow = document.createElement("div");
                newRow.classList.add("row", "mb-3", "g-1", "align-items-start", "net");

                newRow.innerHTML += `
                <input type="hidden" name="IdContacto" id="IdContacto" />
                <div class="col-3">
                    <select class="form-control netSelect" name="ContactoRedSocials[${index}].IdRedSocial">
                    ${option}
                    </select>
                </div>
                <div class="col-7">
                    <input class="form-control netInput" name="ContactoRedSocials[${index}].UrlPerfil" placeholder="Agrega la url"
                    data-val="true"
                    data-val-required="La Url es obligatoria" />
                    <span data-valmsg-for="ContactoRedSocials[${index}].UrlPerfil"></span>
                </div>
                <div class="col-2">
                    <button type="button" class="btn btn-danger netButtonDelete">
                    Delete
                    </button>
                </div>
                    `;

                this.redSocial.appendChild(newRow);
            }
            ResetInputsModal(){
                this.inputIdContact.value = "";
                this.inputNombre.value = "";
                this.inputApPaterno.value = "";
                this.inputApMaterno.value = "";
                this.inputBirthD.value = "";
                this.inputTelefono.value = "";
                this.inputEmail.value = "";
                this.inputFoto.value = "";
                this.redSocial.replaceChildren();
            }
        }

        document.addEventListener("DOMContentLoaded", () => {
            new Contacto();
        });

    </script>
}